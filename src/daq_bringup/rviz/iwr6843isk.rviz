Panels:
- Class: daq_bringup/RadarPanel
  Name: Radar live values
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /PointCloud21
    Splitter Ratio: 0.5
  Tree Height: 600
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Radar XYZ and SNR
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /daq/view/radar/markers
      Depth: 10
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Filter size: 10
  - Class: rviz_default_plugins/MarkerArray
    Name: Radar origin
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /daq/view/radar/origin
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
  - Class: rviz_default_plugins/Axes
    Name: Reference origin (camera_link)
    Enabled: true
    Reference Frame: <Fixed Frame>
    Length: 0.35
    Radius: 0.012
  - Class: rviz_default_plugins/Axes
    Name: Radar axes (raw frame)
    Enabled: true
    Reference Frame: iwr6843_frame
    Length: 0.5
    Radius: 0.012
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_link
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 1.0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.4
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.14
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 950
  Hide Left Dock: false
  Hide Right Dock: false
  Views:
    collapsed: false
  Width: 1600
  X: 60
  Y: 60
